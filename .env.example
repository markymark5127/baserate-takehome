# Auth: generate with `claude setup-token` and paste here. Never commit the real value.
CLAUDE_CODE_OAUTH_TOKEN=your-token-here
# Optional overrides
MODEL=claude-sonnet-5-5
TOP_K=8
MAX_TURNS=12
# Claim-level grounding check (on/off) and the small model that judges it
GROUNDING=on
# One repair round: the agent gets to fix unsupported sentences before any are removed
REPAIR=on
GROUNDING_MODEL=claude-haiku-5-5
